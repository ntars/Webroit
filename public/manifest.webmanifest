{
  "id": "./",
  "name": "Webroit — 浏览器里的安卓设备管理",
  "short_name": "Webroit",
  "description": "通过 WebUSB 在浏览器里直接连接安卓设备，执行 ADB 与 Fastboot 操作。零安装、零驱动、零后端，数据不出本机。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#141414",
  "theme_color": "#141414",
  "categories": ["utilities", "developer", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "连接设备",
      "short_name": "连接",
      "description": "打开应用并进入连接面板",
      "url": "./",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "应急重置显示",
      "short_name": "救砖",
      "description": "屏幕被改坏时恢复分辨率与密度",
      "url": "./#/reset-display",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
